# The song part of the pattern pop-up: what Play plays, and the play order of the patterns. Ids start with "song-".

# The switch: what the Play button plays, the pattern being edited or the song.
song-play-pattern = Pattern
song-play-song = Song
song-order = The song plays these patterns in order:
song-empty = None yet. Add a pattern below.
# $name is a pattern's letter, such as A.
song-take-out-keeps = Taking { $name } out of the song keeps pattern { $name }.
# Move the chosen entry earlier or later in the song.
song-move-left = Move left
song-move-right = Move right
song-take-out = Take out
song-done = Done
# Adds pattern $name, a letter such as A, to the end of the song.
song-add = Add { $name }
# Whether the song starts again when it ends.
song-repeat = Repeat
song-hint = Tap a pattern in the song to move it or take it out.
