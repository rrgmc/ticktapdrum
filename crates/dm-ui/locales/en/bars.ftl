# The bar pop-up, and bar numbers over the grid. Ids start with "bars-".

# Over the grid, at the first step of each bar when several bars show. $number counts from 1.
bars-header = Bar { $number }
bars-add = Add bar
bars-remove-last = Remove last bar
bars-copy = Copy bar
# Whether the grid follows the bar being played.
bars-follow = Follow
# Asked before the last bar goes. $number counts from 1.
bars-remove-question = Remove bar { $number }? Its notes go too.
bars-remove = Remove
# Answers the question: do not remove the bar.
bars-keep = Cancel
