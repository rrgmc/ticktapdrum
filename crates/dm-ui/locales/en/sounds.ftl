# The Sounds dialog: the drum kit and adding a row. Ids start with "sounds-".
# Kit names come from the sound bank and are not translated.

sounds-kit = Drum kit
# Opens the list of every kit the bank has.
sounds-all-kits = All kits
# The same, when the kit in use is not in the short list. $kit is its name, from the bank.
sounds-all-kits-current = All kits ({ $kit })
sounds-add-row = Add a row
sounds-max-rows = A project holds at most { $count } rows.
# Opens the drums that are not in the short list of common ones.
sounds-more-drums = More drums
