# The tempo pop-up: tempo and swing. Ids start with "tempo-".

# Hover text on the − and + buttons beside the tempo.
tempo-slower = Slower
tempo-faster = Faster
# Under the tempo number, which is in beats per minute.
tempo-bpm = Beats per minute
tempo-swing = Swing
# $triplet is the swing amount, in percent, that gives a triplet feel.
tempo-swing-help = Delays every second step for a shuffling, swinging feel. About { $triplet }% is a triplet shuffle.
