# The app as a whole. Ids start with "app-".

# The app's name, as the window title shows it.
app-name = TickTapDrum
# The window's title once the project has a name. $name is the project's name.
app-title-named = { $name } - TickTapDrum

# Where a phone's exports are, as the Files app on an iPhone or iPad shows the app's folder.
app-export-place-iphone = the Files app, under On My iPhone, { app-name }, exports
app-export-place-ipad = the Files app, under On My iPad, { app-name }, exports
