# A row's settings, in the pop-up beside its name in the grid. Ids start with "rows-".

# Ends renaming the row and keeps the name typed.
rows-done = Done
rows-mute = Mute
rows-solo = Solo
rows-volume = Volume
# Move the row one place up or down in the grid.
rows-up = Up
rows-down = Down
# A heading over commands that change only the pattern being edited.
rows-in-this-pattern = In this pattern
# Turns on the row's step on every beat (every fourth step).
rows-every-beat = Every beat
rows-every-two-steps = Every 2 steps
# Turns off every step of the row in this pattern.
rows-clear = Clear
rows-remove-row = Remove row
rows-remove-question = Remove { $name }?
rows-remove-question-notes = Remove { $name }? Its notes in every pattern go too.
rows-remove = Remove
# Answers the question about removing the row: do not remove it.
rows-keep = Cancel
# Goes back from the list of drums to the row's settings.
rows-back = Back

# One letter beside a row's name in the grid, for a muted row and a soloed row.
rows-badge-mute = M
rows-badge-solo = S
# The hint on the mark beside a row whose drum the kit playing has no sound for.
rows-no-sound = This kit has no sound for this drum.

# Hover text on an inactive row: a drum played on the MIDI keyboard that has no row yet.
rows-add-offered = Add this drum
# Hover text on the cross of a faded drum row: takes the drum away, with what was recorded on it.
rows-remove-offered = Remove this drum
