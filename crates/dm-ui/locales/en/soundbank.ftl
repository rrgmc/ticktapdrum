# The Sound bank dialog: which SoundFont plays. Ids start with "soundbank-". $name is a file's
# name without .sf2, which is not translated.

soundbank-intro = The drum sounds come from a SoundFont. Choose the one to play.
# Under a SoundFont's name: the space it takes, in whole mebibytes (MiB).
soundbank-size = { $size } MiB
soundbank-not-downloaded = Not downloaded
soundbank-delete = Delete
soundbank-delete-question = Delete the SoundFont { $name } from this device?
soundbank-add = Add a SoundFont file
soundbank-add-hint = A copy of the .sf2 file is kept in the app.
# Where the platform has no file picker, such as iOS: a file shared to the app is added.
soundbank-add-share = To add a SoundFont, share an .sf2 file to TickTapDrum.
soundbank-adding = Adding { $name }
# The kind of file in the system's open dialog.
soundbank-file-kind = SoundFont
