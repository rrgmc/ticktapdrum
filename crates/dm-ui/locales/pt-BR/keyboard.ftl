## A etapa do estilo para teclado, que escolhe o padrão de cada seção do estilo. Os nomes das
## seções seguem o que os teclados arranjadores imprimem nos botões, que ficam em inglês.

# Acima da lista de seções.
keyboard-sections-about = Escolha um padrão para cada parte do estilo. O Main A é obrigatório.
# A seção que toca uma vez antes de a batida começar.
keyboard-intro = Intro
# Uma das quatro batidas principais. $letter é A, B, C ou D, como nos botões do teclado.
keyboard-main = Main { $letter }
# A virada de um compasso tocada ao passar para o Main $letter. No teclado o botão diz "Fill In".
keyboard-fill = Virada { $letter }
# Uma pausa ou batida de um compasso que interrompe o ritmo. No teclado o botão diz "Break".
keyboard-break = Break
# A seção que toca uma vez para terminar. No teclado o botão diz "Ending".
keyboard-ending = Ending
# A escolha que deixa uma seção de fora.
keyboard-none = Nenhum
# Sob uma virada deixada em Nenhum. $letter é a letra do Main.
keyboard-fill-from-main = O último compasso do Main { $letter } toca como virada.
# Por que o botão final está desativado. Aparece um de cada vez.
keyboard-problem-no-main-a = Escolha um padrão para o Main A.
keyboard-problem-not-one-bar = As viradas e o Break precisam ser padrões de um compasso.
keyboard-problem-no-such-pattern = Um padrão escolhido não existe mais. Escolha de novo.
# Os botões finais: salvar o estilo num arquivo ou enviá-lo ao teclado.
keyboard-save = Salvar
keyboard-send = Enviar
