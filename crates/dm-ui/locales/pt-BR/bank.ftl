# Obter o banco de sons: a oferta de download, o download, o carregamento e os erros.
# Os ids começam com "bank-". $bank é o nome do banco, que não se traduz.

bank-offer-title = Faltam os sons de bateria
bank-offer = O TickTapDrum toca os sons de um banco de instrumentos, o { $bank }. Ele é baixado uma vez e fica guardado neste aparelho.
bank-offer-sizes = Download: { $download } MiB. Espaço ocupado: { $space } MiB.
bank-license-colombo = Licença: CC-BY-SA 4.0, segundo o próprio arquivo; os créditos dele citam outros bancos entre as fontes das amostras.
bank-license = Licença: { $license }.
bank-download = Baixar

bank-installing-title = Baixando os sons de bateria
bank-connecting = Conectando
bank-downloading = Baixando: { $done } MiB de { $total } MiB
bank-checking-download = Verificando o download
bank-unpacking = Descompactando: { $done } MiB de { $total } MiB
bank-checking-sounds = Verificando os sons
bank-cancel = Cancelar

bank-loading-title = Carregando os sons de bateria

bank-failed-title = Algo deu errado
bank-try-again = Tentar de novo
# Nos erros, $detail é a descrição do problema dada pelo sistema, muitas vezes em inglês.
bank-error-download = O download falhou: { $detail }
bank-error-mismatch-archive = O arquivo baixado não era o esperado e foi apagado.
bank-error-mismatch-bank-file = O arquivo de sons descompactado não era o esperado e foi apagado.
bank-error-archive = Não foi possível descompactar o arquivo baixado: { $detail }
bank-error-file = Não foi possível ler ou gravar um arquivo neste aparelho: { $detail }
bank-error-cancelled = O download foi cancelado.
bank-error-soundfont = Não foi possível carregar os sons de bateria: { $detail }
bank-error-device = Não foi possível abrir a saída de áudio: { $detail }
bank-error-nothing = Não há nada para tocar.
bank-error-render-cancelled = A renderização foi cancelada.
bank-error-installer-stopped = O download parou inesperadamente.
bank-error-loading-stopped = O carregamento dos sons de bateria parou inesperadamente.
