<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The app downloads its instrument bank on first start. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- hasCode is true for one small Java class, MainActivity, which extends Android's
         NativeActivity. NativeActivity loads libticktapdrum.so, which holds the whole app.
         MainActivity adds only the system file picker, whose answer reaches the activity that
         started it and which NativeActivity cannot receive, and passes on what other apps share
         with this one (see the intent filters below).

         enableOnBackInvokedCallback is false so the Back button reaches the app as a key press.
         Otherwise Android handles Back itself and closes the activity. The app closes its open
         pop-up or dialog on Back, and with none open moves itself to the background, which
         keeps the activity alive. When the activity is destroyed anyway, the app ends its
         process (see Logger in apps/dm-android/src/lib.rs), because winit ignores the
         destruction and the next launch in the same process would hang.

         localeConfig lists the app's languages, so Android 13 and later let the person pick one
         for this app alone, in the system settings. -->
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:localeConfig="@xml/locales_config">

        <!-- configChanges lists the changes the app handles itself, so rotating the screen or
             resizing the window does not destroy and restart the activity. With locale listed,
             a change of language reaches the running app, which reads it from the
             configuration (see Host in apps/dm-android/src/lib.rs).

             singleTask keeps one copy of the activity: a share into the running app reaches it
             through onNewIntent instead of starting a second copy. -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|fontWeightAdjustment|locale|layoutDirection">
            <meta-data
                android:name="android.app.lib_name"
                android:value="ticktapdrum" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share a link with the app: Share in a browser, for example. The app downloads
                 the groove file the link points to. Any shared text matches; the app decides
                 what to do with it. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- Share a MIDI or zip file with the app: Share in a file manager, for example.
                 The app imports the grooves in it. Only these types are listed, not every type,
                 so the app does not appear in the Share sheet for photos and the like. A file
                 the sender labels with another type cannot be shared; it can still be opened
                 from the menu. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

            <!-- Open a MIDI or zip file with the app: "Open with" in a file manager, or tapping
                 a downloaded file. The same types as above, from a content:// or file://
                 address. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/midi" />
                <data android:mimeType="audio/x-midi" />
                <data android:mimeType="audio/mid" />
                <data android:mimeType="application/x-midi" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>
    </application>
</manifest>
